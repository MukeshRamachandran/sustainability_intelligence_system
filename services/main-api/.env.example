APP_ENV=development
DATABASE_URL=postgresql+psycopg://microcosm_app:microcosm_dev_only@postgres:5432/microcosm
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
INSTITUTION_TIMEZONE=Asia/Kolkata
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=development-only-change-me
CSRF_SECRET=development-csrf-change-me
SESSION_COOKIE_NAME=microcosm_session
CSRF_COOKIE_NAME=microcosm_csrf
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=8
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
EVIDENCE_ROOT=/data/evidence
CERTIFICATE_STORAGE_ROOT=/app/certificate-storage
MAX_UPLOAD_BYTES=10485760
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=12

# Aeron ingestion worker only (python -m app.environment.worker).
# The worker reads these from the process environment, never from this file;
# supply real values through a secret store.
# Aeron Live3 REST API v1, authenticated with a Bearer API key (no browser).
AERON_STATION_ID=b1ce41c2-586a-4a26-9382-9d8bfe757e78
AERON_API_BASE_URL=https://live3.aeronsystems.com/api/v1
AERON_API_KEY=
# Aeron's latest reading changes about every 7 minutes. 300 s = 288 of the
# 10000 requests Aeron allows per day. Values are clamped to 120-3600.
AERON_POLL_INTERVAL_SECONDS=300
AERON_CONNECT_TIMEOUT_SECONDS=5
AERON_READ_TIMEOUT_SECONDS=15
AERON_MAX_ATTEMPTS=3
